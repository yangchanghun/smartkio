DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=api.example.com,211.37.174.174
DJANGO_CORS_ALLOWED_ORIGINS=https://admin.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com
# 로컬에서 Docker 없이 테스트할 때만 1로 설정합니다.
DJANGO_USE_SQLITE=0
POSTGRES_DB=smartkio
POSTGRES_USER=smartkio
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
KIOSK_API_KEY=generate-a-separate-device-key
# Vercel 배포는 비워 둡니다. vercel.json이 /api를 운영 서버로 프록시합니다.
VITE_API_URL=
EXPO_PUBLIC_API_URL=https://api.example.com
EXPO_PUBLIC_KIOSK_KEY=the-same-device-key-used-for-this-build
